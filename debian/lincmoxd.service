[Unit]
Description=LincMox daemon — REST API and Web UI for LincStation LED control
After=network.target
Documentation=https://doc.lincmox.ovh

[Service]
Type=simple
ExecStart=/usr/bin/lincmoxd --sock /run/lincmoxd.sock --addr :8080
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# I2C device access
DeviceAllow=/dev/i2c-* rw
RuntimeDirectory=lincmoxd
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

